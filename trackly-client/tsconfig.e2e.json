/* The Playwright journeys: a separate program so the app build never sees the test runner's types. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/e2e",
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "e2e-stack/**/*.ts",
    "playwright.config.ts",
    "playwright.stack.config.ts"
  ]
}
